{
  "name": "orbit-tower",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "stress": "k6 run tests/stress-test.js",
    "stress:smoke": "k6 run --env K6_DURATION=10s --env K6_VUS=10 tests/stress-test.js",
    "stress:load": "k6 run --env K6_DURATION=2m --env K6_VUS=50 tests/stress-test.js",
    "stress:prod": "k6 run --env BASE_URL=https://orbit-tower.vercel.app tests/stress-test.js",
    "stress:spike": "k6 run --scenario spike_test tests/stress-test.js",
    "stress:drift": "k6 run --scenario drift_api_stress --env K6_DURATION=1m --env K6_VUS=100 tests/stress-test.js",
    "stress:claims": "k6 run --scenario concurrent_claims tests/stress-test.js",
    "stress:docker": "docker run --rm -i grafana/k6 run - < tests/stress-test.js",
    "stress:report": "k6 run --out json=tests/reports/result.json tests/stress-test.js && echo 'Report saved to tests/reports/result.json'",
    "test:security": "k6 run tests/security-test.js",
    "test:security:prod": "k6 run --env BASE_URL=https://orbit-tower.vercel.app tests/security-test.js"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "^3.1.3",
    "@supabase/supabase-js": "^2.39.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.52.0",
    "next": "^15.0.0",
    "postprocessing": "^6.39.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
